# Copy this file to .env (local testing ke liye) — .env kabhi git me push mat karna.
# Production me ye values host ke Environment Variables me set karte hain.

# WhatsApp Cloud API access token (permanent / system user token)
WHATSAPP_TOKEN=EAAG...

# Business phone number ID (Meta dashboard -> WhatsApp -> API Setup me milta hai)
PHONE_NUMBER_ID=1234567890123

# WhatsApp Business Account ID (WABA) — "npm run check" me verify hota hai
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890123456

# Aapka apna number (digits only, country code ke sath) — is number ke messages pe reply NAHI hota
WHATSAPP_PHONE=923001234567

# Meta dashboard me webhook subscribe karte waqt yahi verify token likhna hai
WEBHOOK_VERIFY_TOKEN=monarch-assistant-verify

# Graph API version (default v25.0)
WHATSAPP_API_VERSION=v25.0

# Local port
PORT=3000
